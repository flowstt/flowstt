{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowSTT",
  "version": "0.2.6",
  "identifier": "io.flowstt",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FlowSTT",
        "width": 600,
        "height": 300,
        "minWidth": 480,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$DATA/vtx-engine/recordings/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxREYxMjhGN0UzRTA4MDgKUldRSUNENStqeExmWVFlSHJ2S1RyNU02TUc3dDZyMlhIb0oxS3A4MEtvTHZxM0R4Y2p4L2k4QXYK",
      "endpoints": [
        "https://github.com/flowstt/flowstt/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "icons/tray/*": "icons/tray/",
      "icons/tray/macos/*": "icons/tray/macos/"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser"
      },
      "wix": {
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "signingIdentity": "Developer ID Application: Keath Milligan (WMYVSJCH96)",
      "minimumSystemVersion": "12.3",
      "infoPlist": "Info.plist"
    }
  }
}
